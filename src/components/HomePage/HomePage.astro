---
import ThemeToggle from '../ThemeToggle/ThemeToggle.astro'
import type { HomeCopy, Locale } from '../../copy/home'
import './HomePage.css'

interface Props {
  locale: Locale
  copy: HomeCopy
}

const { locale, copy: t } = Astro.props
---

<div class="home_page">
  <div class="home_page-rails">
    <!-- ===================== HERO ===================== -->
    <section class="home_page-section" data-section="hero">
      <div class="home_page-registration_mark_anchor" aria-hidden="true"></div>
      <div class="l_stack" data-gap="8">
        <div class="l_cluster" data-justify="between" data-gap="4" data-align="center">
          <span class="home_page-hero_tag">{t.hero.tag}</span>
          <div class="l_cluster" data-gap="1" data-align="center" data-nowrap>
            {
              locale === 'ru' && (
                <a class="home_page-locale_link" href="/" hreflang="en" lang="en">
                  EN
                </a>
              )
            }
            <ThemeToggle label={t.ui.themeToggle} />
          </div>
        </div>

        <div class="l_stack" data-gap="5">
          <h1 class="home_page-title">{t.hero.name}</h1>
          <p class="home_page-hero_lead">{t.hero.lead}</p>
        </div>
      </div>
    </section>

    <!-- ===================== CORE BELIEFS ===================== -->
    <section class="home_page-section" data-section="beliefs">
      <div class="home_page-registration_mark_anchor" aria-hidden="true"></div>
      <div class="l_stack" data-gap="6">
        <header class="home_page-section_head">
          <div class="l_cluster" data-justify="between" data-gap="4" data-align="end">
            <h2 class="home_page-section_title">{t.beliefs.title}</h2>
          </div>
        </header>

        <ul class="home_page-principle_list u_reset_list">
          {
            t.beliefs.items.map((item) => (
              <li class="home_page-principle">
                <div class="l_cluster" data-gap="4" data-align="center" data-nowrap>
                  <span class="home_page-principle_index" data-nosnippet>
                    {item.index}
                  </span>
                  <p class="home_page-principle_text">{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ===================== SELECTED WORK ===================== -->
    <section class="home_page-section" data-section="work">
      <div class="home_page-registration_mark_anchor" aria-hidden="true"></div>
      <div class="l_stack" data-gap="6">
        <header class="home_page-section_head">
          <div class="l_cluster" data-justify="between" data-gap="4" data-align="end">
            <h2 class="home_page-section_title">{t.work.title}</h2>
          </div>
        </header>

        <div class="home_page-work_list">
          {
            t.work.items.map((item) => (
              <article class="work_card">
                <div class="l_cluster" data-justify="between" data-gap="2" data-align="start">
                  <span class="work_card-index" data-nosnippet>
                    {item.index}
                  </span>
                  <span class="work_card-tag" data-nosnippet>
                    {item.tag}
                  </span>
                </div>
                <div class="l_stack" data-gap="2">
                  <h3 class="work_card-title">
                    <a class="work_card-link" target="_blank" href={item.href}>
                      {item.title}
                    </a>
                  </h3>
                  <p class="work_card-desc">{item.description}</p>
                </div>
                <div class="l_spacer"></div>
                <div class="l_cluster" data-justify="between" data-gap="2">
                  <span class="work_card-host u_truncate" data-nosnippet>
                    {item.host}
                  </span>
                  <span class="work_card-arrow" aria-hidden="true" data-nosnippet>
                    ↗
                  </span>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===================== BIO TIMELINE ===================== -->
    <section class="home_page-section" data-section="bio">
      <div class="home_page-registration_mark_anchor" aria-hidden="true"></div>
      <div class="l_stack" data-gap="6">
        <header class="home_page-section_head">
          <div class="l_cluster" data-justify="between" data-gap="4" data-align="end">
            <h2 class="home_page-section_title">{t.bio.title}</h2>
          </div>
        </header>

        <ol class="home_page-bio_list u_reset_list">
          {
            t.bio.entries.map((entry) => (
              <li class="home_page-bio_entry" data-active={entry.active ? 'true' : undefined}>
                <span class="home_page-bio_year" data-nosnippet>
                  {entry.year}
                </span>
                <p class="home_page-bio_desc">
                  {entry.parts.map((part) =>
                    typeof part === 'string' ? (
                      part
                    ) : part.nosnippet ? (
                      <span data-nosnippet>
                        <a target="_blank" href={part.href}>
                          {part.label}
                        </a>
                      </span>
                    ) : (
                      <a target="_blank" href={part.href}>
                        {part.label}
                      </a>
                    ),
                  )}
                  {entry.active && (
                    <>
                      &thinsp;<span class="home_page-bio_caret" aria-hidden="true" data-nosnippet />
                    </>
                  )}
                </p>
                <span class="home_page-bio_age" data-nosnippet>
                  {entry.age}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ===================== CONTACT ===================== -->
    <section class="home_page-section" data-section="contact">
      <div class="home_page-registration_mark_anchor" aria-hidden="true"></div>
      <div class="l_stack" data-gap="6">
        <header class="home_page-section_head">
          <div class="l_cluster" data-justify="between" data-gap="4" data-align="end">
            <h2 class="home_page-section_title">{t.contact.title}</h2>
          </div>
        </header>

        <ul class="home_page-contact_list u_reset_list">
          {
            t.contact.items.map((item) => (
              <li class="home_page-contact_row">
                <div class="l_cluster" data-justify="between" data-gap="4">
                  <span class="home_page-contact_label" data-nosnippet>
                    {item.label}
                  </span>
                  <a class="home_page-contact_value" href={item.href} target={item.external ? '_blank' : undefined}>
                    {item.value}
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="home_page-registration_mark_anchor" aria-hidden="true"></div>
    </section>
  </div>
</div>
