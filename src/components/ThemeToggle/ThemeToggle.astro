---
import Icon from '../Icon/Icon.astro'
import themeIcon from '~icons/ri/contrast-fill?raw'
import './ThemeToggle.css'
---

<button
  class="theme_toggle u_reset_button"
  type="button"
  data-preference="auto"
  aria-label="Theme: system. Switch to light theme."
>
  <Icon content={themeIcon} class="theme_toggle-icon" aria-hidden="true" focusable="false" />
  <span class="theme_toggle-label">system</span>
</button>

<script src="./ThemeToggle.ts"></script>
